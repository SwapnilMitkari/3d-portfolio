    {
      "parameters": {
        "content": "## GATE 3 — DOCUMENTS\nSupplier returns and uploads a PDF (insurance, trade license, tax cert, ISO cert). AI reads it, extracts doc type + expiry date, and we compute status: valid / expiring_soon / expired_or_missing. Logged to the Documents sheet, then routed to the right email — procurement gets escalated on bad docs, supplier gets reminded on soon-to-expire ones, and only a valid document continues on to Gate 4.",
        "height": 432,
        "width": 1924,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [-128, 400],
      "typeVersion": 1,
      "id": "ba02a697-4caa-46d5-afe2-68b9b3a1a4f6",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "jsCode": "const registry = $json; // from Gate4 - Lookup Registry Data\nconst docStatus = $('Gate3 - Compute Compliance Status').item.json.status;\n\nlet score = 0;\nconst flags = [];\n\nif (docStatus !== 'valid') { score += 30; flags.push('document_issue'); }\nif (!/^[A-Z0-9]{10,15}$/i.test(registry.taxId || '')) { score += 25; flags.push('invalid_tax_id_format'); }\nif (['Raw Materials', 'Chemicals'].includes(registry.category)) { score += 15; flags.push('high_risk_category'); }\nscore += 20; flags.push('new_supplier_no_history');\n\nconst riskLevel = score >= 61 ? 'High' : score >= 31 ? 'Medium' : 'Low';\n\nreturn {\n  json: {\n    supplierId: registry.supplierId,\n    companyName: registry.companyName,\n    riskScore: score,\n    riskLevel,\n    flags: flags.join(', ')\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1696, 992],
      "id": "84f8a667-47d2-413f-983f-a0e4bc6da107",
      "name": "Gate4 - Calculate Risk Score"
    },
