      "parameters": {
        "jsonSchemaExample": "{ \"supplierName\": \"ABC Suppliers Pvt Ltd\", \"documentType\": \"Insurance Certificate\", \"expiryDate\": \"2026-11-15\", \"confidence\": \"high\" }"
