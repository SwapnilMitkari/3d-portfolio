    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const output = $json.output || $json;\nconst documentType = output.documentType || 'unrecognized';\nconst expiryDateStr = output.expiryDate || null;\nconst supplierId = $('Gate3 - Document Upload Form').item.json['Supplier ID'];\n\nlet status, daysUntilExpiry = null;\nif (!expiryDateStr || documentType === 'unrecognized') {\n  status = 'expired_or_missing';\n} else {\n  const days = Math.floor((new Date(expiryDateStr) - new Date()) / 86400000);\n  daysUntilExpiry = days;\n  status = days < 0 ? 'expired_or_missing' : days <= 30 ? 'expiring_soon' : 'valid';\n}\n\nreturn { json: { supplierId, documentType, expiryDate: expiryDateStr, daysUntilExpiry, status } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
